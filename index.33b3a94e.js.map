"use strict";
document.addEventListener("click", function(e) {
    var wall = e.target.closest(".wall");
    if (!wall) return;
    var spider = wall.querySelector(".spider");
    if (!spider) return;
    var wallRect = wall.getBoundingClientRect();
    var pointerX = e.clientX - wallRect.left - wall.clientLeft;
    var pointerY = e.clientY - wallRect.top - wall.clientTop;
    var maxLeft = wall.clientWidth - spider.offsetWidth;
    var maxTop = wall.clientHeight - spider.offsetHeight;
    var spiderLeft = Math.min(Math.max(pointerX - spider.offsetWidth / 2, 0), maxLeft);
    var spiderTop = Math.min(Math.max(pointerY - spider.offsetHeight / 2, 0), maxTop);
    spider.style.left = "".concat(spiderLeft, "px");
    spider.style.top = "".concat(spiderTop, "px");
});

